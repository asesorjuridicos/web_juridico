PORT=5500
OFFICIAL_CALC_PROXY_URL=https://tasas-chaco-proxy.asesoresjuridicosinmo.workers.dev/calculate

# ── Envio de correo del formulario de contacto ──────────────────────────────
# En produccion el formulario NO usa estas variables: envia directo desde el
# navegador a Web3Forms (ver CONTACT_ENDPOINT en script.js), porque el plan
# gratuito de ese servicio rechaza las solicitudes hechas desde un servidor.
# Lo de abajo sirve solo para probar /api/contacto en desarrollo local.

# IMPORTANTE (produccion en Render): el plan gratuito de Render bloquea el
# trafico SMTP saliente en los puertos 25, 465 y 587. Si se usa
# smtp.gmail.com:587 la conexion queda colgada y el formulario nunca responde.
# Por eso en produccion se usa un relay que escucha en el puerto 2525.
#
# Produccion (Render) - relay Brevo:
#   SMTP_HOST=smtp-relay.brevo.com
#   SMTP_PORT=2525
#   SMTP_SECURE=false
#   SMTP_USER=<login SMTP que da Brevo, ej. 9a1b2c001@smtp-brevo.com>
#   SMTP_PASS=<SMTP key de Brevo>
#
# Desarrollo local (Gmail funciona porque no hay bloqueo de puertos):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

SMTP_USER=usuario@ejemplo.com
SMTP_PASS=reemplazar-con-la-clave-real

# Tiempos maximos de espera contra el servidor SMTP (milisegundos).
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=15000

CONTACT_TO_EMAIL=asesoresjuridicosinmo@gmail.com
# CONTACT_FROM_EMAIL debe ser un remitente verificado en el proveedor de envio.
CONTACT_FROM_EMAIL=asesoresjuridicosinmo@gmail.com

CONTACT_SUBJECT_PREFIX=[Web Juridico]

# ── Aviso interno por WhatsApp (CallMeBot) ──────────────────────────────────
# Opcional: si faltan estas variables, el aviso se saltea sin romper nada.
# La API key se obtiene enviando "I allow callmebot to send me messages" por
# WhatsApp al +34 644 596 804. Incluir el telefono con codigo de pais.
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=
